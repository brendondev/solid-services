# ============================================================================
# Solid Service - variáveis de ambiente
#
# Copie para .env na raiz do monorepo:   cp .env.example .env
# A API (apps/api) e o Prisma CLI leem este mesmo arquivo.
#
# NUNCA coloque credencial real aqui — .env.example é versionado.
# ============================================================================

# ----------------------------------------------------------------------------
# Banco de dados
# ----------------------------------------------------------------------------
# Docker (docker compose up -d postgres) OU Postgres portátil
# (node scripts/local-postgres.js setup) — a URL é a mesma nos dois casos.
DATABASE_URL="postgresql://solid:solid123@localhost:5432/solid_service_dev?schema=public"

# ----------------------------------------------------------------------------
# API
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Em produção troque por um segredo longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=local-dev-secret-nao-usar-em-producao
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# URLs (CORS, links em e-mails e no portal do cliente)
# ----------------------------------------------------------------------------
WEB_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3001
PORTAL_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ----------------------------------------------------------------------------
# Importação
# ----------------------------------------------------------------------------
# true permite importar CPF/CNPJ inválidos (útil para testes)
SKIP_DOCUMENT_VALIDATION=true

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# Sem S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY o StorageService grava no
# filesystem local — que é o comportamento desejado em desenvolvimento.
LOCAL_STORAGE_PATH=./uploads

# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------------
# Opcionais (desligados em local quando vazios)
# ----------------------------------------------------------------------------
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=

# ----------------------------------------------------------------------------
# Web (apps/web) — só necessário se for apontar para uma API diferente.
# O código já cai em http://localhost:3000/api/v1 por padrão.
# Definir em apps/web/.env.local, pois o Next não lê o .env da raiz.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
